# Copy this file to config/.env: the single operator configuration input.
# Do not commit config/.env. Tool-provider credentials are injected only into egress.
# Model credentials belong to the trusted worker, never to sandbox or server.
# Blank optional settings use centralized deployment/configuration defaults.
PUBLIC_PORT=

# Required database passwords. Supply distinct, strong values for each role.
# Secret generation will be added in the next stage; it is not implemented yet.
POSTGRES_PASSWORD=
SERVER_DB_PASSWORD=
AGENT_DB_PASSWORD=

# Required model endpoint, API key and model identifier for the trusted worker.
# Supply your actual HTTP(S) endpoint and provider-issued key; blanks are placeholders.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=

# Optional until a configured provider route requires fal credentials.
# Supply the provider-issued key here, not in a separate credentials.json file.
FAL_KEY=

# Required shared signing/verification secret for worker and egress (at least 32 characters).
# Supply a securely generated random secret; this blank is not a usable credential.
TURN_TOKEN_SECRET=
