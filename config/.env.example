# Copy this file to config/.env: the single operator configuration input.
# Do not commit config/.env.
# Model credentials belong to the trusted worker, never to sandbox or server.
# Blank optional settings use centralized deployment/configuration defaults.
PUBLIC_PORT=
# PUBLIC_PORT binds Caddy; PORT is the server internal port (default 8787).

# Required database passwords. Supply distinct, strong values for each role.
# Generate each independently with: openssl rand -hex 32
# Passwords must be exactly 64 lowercase hexadecimal characters.
POSTGRES_PASSWORD=
SERVER_DB_PASSWORD=
WORKER_DB_PASSWORD=
SERVER_REDIS_PASSWORD=
WORKER_REDIS_PASSWORD=
# Database name: ASCII letter/underscore followed by letters/digits/underscores.
POSTGRES_DB=
PORT=

# Default Compose includes the worker; startup requires model and E2B settings.
# Submitting Chat may incur model/VM charges; tests never submit to these targets.
# Required model endpoint, API key and model identifier for the trusted worker.
# Supply your actual HTTP(S) endpoint and provider-issued key; blanks are placeholders.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=
# Trusted worker profile path; defaults to /app/profiles/video/instructions.md.
MODEL_PROMPT_PATH=
# Required endpoint-specific limits. The output budget must be below the context window.
MODEL_CONTEXT_WINDOW=
MODEL_MAX_OUTPUT_TOKENS=
# Optional capabilities: true/false and text/text,image. Blank means false and text.
MODEL_REASONING=
MODEL_INPUT=

# Required official E2B control-plane URL, sandbox proxy URL and team API key.
# Local Embed: use the private control-plane and client-proxy endpoints.
# The key stays in the trusted worker; never pass it as a sandbox env variable.
E2B_API_URL=
E2B_SANDBOX_URL=
E2B_API_KEY=
# Optional template and whole-sandbox lifetime: base and 300000 ms by default.
E2B_TEMPLATE=
SANDBOX_TIMEOUT_MS=

# Server-only authentication: canonical HTTPS public origin (no trailing slash/path).
# HTTP is allowed only for localhost/127.0.0.1/[::1] local development.
AUTH_BASE_URL=
# Random secret of at least 32 characters; never project to worker or browser.
AUTH_SECRET=
# GitHub OAuth callback: AUTH_BASE_URL/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Process DATABASE_URL is projected to the selected role by deployment.
# Runtime bounds: 5000 ms DB/Redis IO and 200 ms polling by default.
IO_TIMEOUT_MS=
POLL_MS=
LEASE_MS=
CONCURRENCY=

# Local Silo is provisioned by the short-lived native Compose storage-init job.
# Root credentials stay in objects/storage-init, never in server or worker.
OBJECT_STORAGE_ROOT_USER=
OBJECT_STORAGE_ROOT_PASSWORD=
# Blank endpoint/region/bucket use http://objects:9000, us-east-1, vid-assets.
# External S3: precreate bucket/principals with the two policies (replace bucket).
# storage-init skips external endpoints; it never sends local root to them.
# Applications never create buckets.
# Deployment maps the distinct SERVER_/WORKER_ credentials below to generic
# OBJECT_STORAGE_ACCESS_KEY_ID / OBJECT_STORAGE_SECRET_ACCESS_KEY in each process.
OBJECT_STORAGE_URL=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
SERVER_OBJECT_STORAGE_ACCESS_KEY_ID=
SERVER_OBJECT_STORAGE_SECRET_ACCESS_KEY=
WORKER_OBJECT_STORAGE_ACCESS_KEY_ID=
WORKER_OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Optional asset budgets; defaults and constraints are in packages/config.
ASSET_MAX_BYTES=
ASSET_MAX_FILES=
FILE_IO_TIMEOUT_MS=
# Native sandbox provider (default e2b).
SANDBOX_PROVIDER=
