{
  "name": "video-agent-example",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run typecheck && oxlint --type-aware . && bun run boundaries && bun run schema:check && bun test",
    "typecheck": "tsc --build && tsc -p apps/web",
    "test": "bun test",
    "schema": "bun scripts/database/schema.ts",
    "migrate": "bun scripts/database/migrate.ts",
    "services": "docker compose -f deploy/docker/compose.yaml up -d --wait db redis objects",
    "services:ready": "docker compose -f deploy/docker/compose.yaml run --rm objects-ready",
    "services:down": "docker compose -f deploy/docker/compose.yaml down --volumes",
    "sandbox": "docker build -t vid-sandbox:dev deploy/sandbox",
    "fmt": "prettier --write .",
    "web": "bun --cwd apps/web run dev",
    "skills": "bun apps/agent/scripts/publish-skills.ts",
    "gateway": "docker compose -f deploy/docker/compose.yaml up -d --build gateway",
    "server": "bun --cwd apps/server run dev",
    "agent": "bun --cwd apps/agent run dev",
    "schema:check": "bun scripts/database/schema.ts --check",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps packages"
  },
  "devDependencies": {
    "@ag-ui/core": "^1.0.0",
    "@types/bun": "^1.4.2",
    "dependency-cruiser": "^18.4.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "prettier": "^3.9.0",
    "typescript": "^5.9.0"
  }
}
