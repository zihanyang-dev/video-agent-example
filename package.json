{
  "name": "video-agent-example",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run boundaries && bun run test",
    "test": "bun test apps packages",
    "test:integration": "bun test tests/integration",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings apps packages tests scripts deploy",
    "fmt:check": "prettier --check . '!**/generated/**' '!**/vendor/**' --ignore-path .gitignore",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps packages"
  },
  "devDependencies": {
    "@vid/config": "workspace:*",
    "@vid/database": "workspace:*",
    "@vid/execution-protocol": "workspace:*",
    "@vid/messaging": "workspace:*",
    "redis": "6.3.0",
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "@types/pg": "8.23.1",
    "@swc/core": "1.16.13",
    "typescript": "7.0.2",
    "@types/bun": "1.4.2",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "dependency-cruiser": "18.5.0"
  }
}
