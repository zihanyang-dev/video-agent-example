{
  "name": "video-agent-example",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "check": "tsc --build && oxlint . && bun run schema && git diff --exit-code packages/store/schema.sql",
    "typecheck": "tsc --build",
    "schema": "bun --cwd packages/store scripts/schema.ts",
    "migrate": "bun --cwd packages/store scripts/migrate.ts",
    "fmt": "prettier --write ."
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.0",
    "typescript": "^5.9.0"
  }
}
