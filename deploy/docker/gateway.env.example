# Copy to gateway.env and fill in. That file is not committed: it is the only place in this
# repository where a real provider credential lives (architecture.md §1).
#
# TURN_TOKEN_SECRET signs the token a sandbox carries for one turn. The agent process must
# be given the same value -- it mints what this verifies.
TURN_TOKEN_SECRET=

# One entry per provider a skill may call. The first path segment of a sandbox's request
# picks one: `$VID_GATEWAY/seedance/...` uses `seedance` here.
#
# `key` is sent verbatim as the named header, so it carries its own scheme prefix when the
# provider wants one.
PROVIDERS={"seedance":{"baseUrl":"https://ark.cn-beijing.volces.com","header":"Authorization","key":"Bearer ..."},"seedream":{"baseUrl":"https://ark.ap-southeast.bytepluses.com","header":"Authorization","key":"Bearer ..."}}
