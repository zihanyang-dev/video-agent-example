# Copy to gateway.env and fill in. Media-provider credentials belong to the gateway;
# this local file must not be committed (architecture.md §8).
#
# TURN_TOKEN_SECRET signs the token a sandbox carries for one turn. The agent process must
# be given the same value -- it mints what this verifies.
TURN_TOKEN_SECRET=

# One entry per provider a skill may call. The first path segment of a sandbox's request
# picks one: `$VID_GATEWAY/seedance/...` uses `seedance` here.
#
# `key` is sent verbatim as the named header, so it carries its own scheme prefix when the
# provider wants one.
#
# `models` is optional and is the one thing this process reads out of a request body. Leave
# it out and any model may be asked for; list them and anything else is refused before the
# call goes out. Measured: an agent read a parameter error as the model being unavailable,
# picked another one and generated footage on it -- a skill script cannot prevent that,
# because the agent can read the script and call here directly.
#
# `results` names the origins a provider puts finished files on. The sandbox network is
# `internal: true`, so a skill cannot fetch a CDN link itself -- it asks for it here, and
# only these origins are fetched, redirects included. Leave it out and nothing is fetched: a
# gateway that would retrieve any URL handed to it is an open proxy standing inside our
# network. Origins rather than hostnames, so the scheme is part of what was named.
PROVIDERS={"seedance":{"baseUrl":"https://ark.cn-beijing.volces.com","header":"Authorization","key":"Bearer ...","models":["doubao-seedance-2-0-260128"],"results":["https://ark-acg-cn-beijing.tos-cn-beijing.volces.com"]},"seedream":{"baseUrl":"https://ark.ap-southeast.bytepluses.com","header":"Authorization","key":"Bearer ...","models":["seedream-4-5-251128"],"results":["https://ark-content-generation-v2-ap-southeast-1.tos-ap-southeast-1.volces.com"]}}
