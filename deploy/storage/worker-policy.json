{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::vid-assets/assets/uploads/*",
        "arn:aws:s3:::vid-assets/assets/generated/*",
        "arn:aws:s3:::vid-assets/materials/*",
        "arn:aws:s3:::vid-assets/artifacts/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": ["arn:aws:s3:::vid-assets/assets/generated/*"]
    }
  ]
}
